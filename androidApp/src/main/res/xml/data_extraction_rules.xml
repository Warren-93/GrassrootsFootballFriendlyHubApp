<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the same rule as backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gffh_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gffh_session.xml" />
    </device-transfer>
</data-extraction-rules>
